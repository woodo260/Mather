<% content_for :title, "#{@deck.name} – Mather" %>

<div class="space-y-6">
  <div>
    <%= link_to "← All decks", decks_path, class: "text-sm text-gray-500 dark:text-gray-400 hover:text-indigo-600 dark:hover:text-indigo-400" %>
  </div>

  <div class="flex items-start justify-between gap-4">
    <div>
      <h1 class="text-3xl font-bold text-gray-900 dark:text-gray-100"><%= @deck.name %></h1>
      <% if @deck.description.present? %>
        <p class="mt-1 text-gray-500 dark:text-gray-400"><%= @deck.description %></p>
      <% end %>
      <p class="mt-2 text-xs text-gray-400 dark:text-gray-500">
        <%= pluralize(@counts[:total], "card") %> ·
        <%= @counts[:due] %> due · <%= @counts[:new] %> new
        <% if @deck.builtin %> · <span class="italic">built-in</span><% end %>
      </p>
    </div>
    <div class="flex-shrink-0 flex flex-col gap-2 text-sm items-stretch">
      <% if (@counts[:due] + @counts[:new]).positive? %>
        <%= link_to "Review", review_deck_path(@deck),
              class: "text-center bg-indigo-600 hover:bg-indigo-700 text-white font-semibold px-4 py-2 rounded-xl transition-colors shadow-sm" %>
      <% end %>
      <% if @deck.editable? %>
        <%= link_to "Add card", new_deck_card_path(@deck),
              class: "text-center text-indigo-600 dark:text-indigo-400 border border-indigo-200 dark:border-indigo-800 px-4 py-2 rounded-xl hover:bg-indigo-50 dark:hover:bg-indigo-950/40 transition-colors" %>
        <%= link_to "Edit deck", edit_deck_path(@deck),
              class: "text-center text-gray-600 dark:text-gray-400 border border-gray-200 dark:border-gray-700 px-4 py-2 rounded-xl hover:border-indigo-300 dark:hover:border-indigo-600 transition-colors" %>
        <%= button_to "Delete deck", deck_path(@deck), method: :delete,
              form: { data: { turbo_confirm: "Delete this deck and all its cards?" } },
              class: "text-center text-red-600 dark:text-red-400 border border-red-200 dark:border-red-900 px-4 py-2 rounded-xl hover:bg-red-50 dark:hover:bg-red-950/40 transition-colors cursor-pointer" %>
      <% end %>
    </div>
  </div>

  <div class="bg-white dark:bg-gray-900 rounded-2xl shadow-sm border border-gray-200 dark:border-gray-800 divide-y divide-gray-100 dark:divide-gray-800">
    <% if @deck.cards.empty? %>
      <p class="p-6 text-sm text-gray-400 dark:text-gray-500 text-center">No cards yet.</p>
    <% end %>
    <% @deck.cards.each do |card| %>
      <div class="p-5 flex items-start justify-between gap-4">
        <div class="min-w-0 space-y-1">
          <p class="font-medium text-gray-900 dark:text-gray-100"><%= card.front %></p>
          <p class="text-sm text-gray-500 dark:text-gray-400"><%= card.back %></p>
        </div>
        <% if @deck.editable? %>
          <div class="flex-shrink-0 flex gap-2 text-xs">
            <%= link_to "Edit", edit_deck_card_path(@deck, card),
                  class: "text-gray-500 dark:text-gray-400 hover:text-indigo-600 dark:hover:text-indigo-400" %>
            <%= button_to "Delete", deck_card_path(@deck, card), method: :delete,
                  form: { data: { turbo_confirm: "Delete this card?" } },
                  class: "text-red-500 dark:text-red-400 hover:underline cursor-pointer" %>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
