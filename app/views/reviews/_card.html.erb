<div data-controller="flashcard" class="bg-white dark:bg-gray-900 rounded-2xl shadow-sm border border-gray-200 dark:border-gray-800 overflow-hidden">

  <div class="bg-indigo-50 dark:bg-indigo-950/40 border-b border-indigo-100 dark:border-indigo-900 px-6 py-3 flex items-center justify-between">
    <span class="text-xs font-semibold text-indigo-600 dark:text-indigo-400 uppercase tracking-wide">
      <%= card.deck.name %>
    </span>
    <span class="text-xs text-indigo-400 dark:text-indigo-300"><%= pluralize(remaining, "card") %> left</span>
  </div>

  <div class="p-8 space-y-6">
    <%# Front %>
    <p class="text-2xl sm:text-3xl font-bold text-gray-900 dark:text-gray-100 text-center leading-relaxed">
      <%= card.front %>
    </p>

    <%# Reveal button (hidden once flipped) %>
    <div data-flashcard-target="reveal" class="flex justify-center">
      <button type="button" data-action="flashcard#reveal"
              class="bg-indigo-600 hover:bg-indigo-700 text-white font-semibold px-8 py-3 rounded-xl transition-colors shadow-sm cursor-pointer">
        Reveal answer
      </button>
      <p class="sr-only">Press Space or Enter to reveal</p>
    </div>

    <%# Back + self-grade (hidden until revealed) %>
    <div data-flashcard-target="answer" hidden class="space-y-6">
      <div class="border-t border-gray-100 dark:border-gray-800 pt-6">
        <p class="text-xl sm:text-2xl font-semibold text-gray-900 dark:text-gray-100 text-center leading-relaxed">
          <%= card.back %>
        </p>
      </div>

      <%= form_with url: grade_deck_path(card.deck), method: :post, class: "space-y-2" do |f| %>
        <%= hidden_field_tag :card_id, card.id %>
        <%= hidden_field_tag :scope, scope %>
        <p class="text-center text-sm text-gray-500 dark:text-gray-400">How well did you know it?</p>
        <%
          base_btn = "flex flex-col items-center gap-0.5 py-3 rounded-xl font-semibold transition-colors cursor-pointer touch-manipulation border"
          ratings = [
            [ "again", "Again", "1", "bg-red-50 dark:bg-red-950/40 text-red-700 dark:text-red-300 hover:bg-red-100 dark:hover:bg-red-950/60 border-red-200 dark:border-red-900" ],
            [ "hard",  "Hard",  "2", "bg-amber-50 dark:bg-amber-950/40 text-amber-700 dark:text-amber-300 hover:bg-amber-100 dark:hover:bg-amber-950/60 border-amber-200 dark:border-amber-900" ],
            [ "good",  "Good",  "3", "bg-green-50 dark:bg-green-950/40 text-green-700 dark:text-green-300 hover:bg-green-100 dark:hover:bg-green-950/60 border-green-200 dark:border-green-900" ],
            [ "easy",  "Easy",  "4", "bg-indigo-50 dark:bg-indigo-950/40 text-indigo-700 dark:text-indigo-300 hover:bg-indigo-100 dark:hover:bg-indigo-950/60 border-indigo-200 dark:border-indigo-900" ],
          ]
        %>
        <div class="grid grid-cols-4 gap-2">
          <% ratings.each do |value, label, key, colors| %>
            <button type="submit" name="rating" value="<%= value %>"
                    data-flashcard-target="rate" data-rating-key="<%= key %>"
                    class="<%= base_btn %> <%= colors %>">
              <span><%= label %></span>
              <span class="text-xs font-normal opacity-60"><%= key %></span>
            </button>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</div>
