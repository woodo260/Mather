<% content_for :title, "Edit card – Mather" %>

<div class="space-y-6">
  <%= link_to "← Back to deck", deck_path(@deck), class: "text-sm text-gray-500 dark:text-gray-400 hover:text-indigo-600 dark:hover:text-indigo-400" %>
  <h1 class="text-3xl font-bold text-gray-900 dark:text-gray-100">Edit card</h1>
  <p class="text-gray-500 dark:text-gray-400 -mt-4"><%= @deck.name %></p>
  <div class="bg-white dark:bg-gray-900 rounded-2xl shadow-sm border border-gray-200 dark:border-gray-800 p-6">
    <%= render "form", card: @card %>
  </div>
</div>
