<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Mather" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="color-scheme" content="light dark">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-gray-50 dark:bg-gray-950 min-h-screen text-gray-900 dark:text-gray-100">

    <%# Navigation %>
    <nav class="bg-white dark:bg-gray-900 border-b border-gray-200 dark:border-gray-800 shadow-sm">
      <div class="max-w-3xl mx-auto px-4 py-3 flex items-center justify-between">
        <a href="/" class="text-2xl font-bold text-indigo-600 dark:text-indigo-400 tracking-tight">Mather</a>
        <div class="flex gap-6 text-sm font-medium">
          <%= link_to "Practice", practice_path,
                class: "text-gray-600 dark:text-gray-400 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors #{controller_name == 'practice' ? 'text-indigo-600 dark:text-indigo-400 font-semibold' : ''}" %>
          <%= link_to "Flashcards", decks_path,
                class: "text-gray-600 dark:text-gray-400 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors #{%w[decks cards reviews].include?(controller_name) ? 'text-indigo-600 dark:text-indigo-400 font-semibold' : ''}" %>
          <%= link_to "Stats", stats_path,
                class: "text-gray-600 dark:text-gray-400 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors #{controller_name == 'stats' ? 'text-indigo-600 dark:text-indigo-400 font-semibold' : ''}" %>
          <%= link_to "Settings", settings_path,
                class: "text-gray-600 dark:text-gray-400 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors #{controller_name == 'settings' ? 'text-indigo-600 dark:text-indigo-400 font-semibold' : ''}" %>
        </div>
      </div>
    </nav>

    <%# Flash messages %>
    <% if notice %>
      <div class="max-w-3xl mx-auto px-4 pt-4">
        <div class="bg-green-50 dark:bg-green-950/40 border border-green-200 dark:border-green-900 text-green-800 dark:text-green-300 rounded-lg px-4 py-3 text-sm">
          <%= notice %>
        </div>
      </div>
    <% end %>
    <% if alert %>
      <div class="max-w-3xl mx-auto px-4 pt-4">
        <div class="bg-red-50 dark:bg-red-950/40 border border-red-200 dark:border-red-900 text-red-800 dark:text-red-300 rounded-lg px-4 py-3 text-sm">
          <%= alert %>
        </div>
      </div>
    <% end %>

    <main class="max-w-3xl mx-auto px-4 py-8">
      <%= yield %>
    </main>

  </body>
</html>
