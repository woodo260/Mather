<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Mather" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-gray-50 min-h-screen text-gray-900">

    <%# Navigation %>
    <nav class="bg-white border-b border-gray-200 shadow-sm">
      <div class="max-w-3xl mx-auto px-4 py-3 flex items-center justify-between">
        <a href="/" class="text-2xl font-bold text-indigo-600 tracking-tight">Mather</a>
        <div class="flex gap-6 text-sm font-medium">
          <%= link_to "Practice", practice_path,
                class: "text-gray-600 hover:text-indigo-600 transition-colors #{controller_name == 'practice' ? 'text-indigo-600 font-semibold' : ''}" %>
          <%= link_to "Stats", stats_path,
                class: "text-gray-600 hover:text-indigo-600 transition-colors #{controller_name == 'stats' ? 'text-indigo-600 font-semibold' : ''}" %>
          <%= link_to "Settings", settings_path,
                class: "text-gray-600 hover:text-indigo-600 transition-colors #{controller_name == 'settings' ? 'text-indigo-600 font-semibold' : ''}" %>
        </div>
      </div>
    </nav>

    <%# Flash messages %>
    <% if notice %>
      <div class="max-w-3xl mx-auto px-4 pt-4">
        <div class="bg-green-50 border border-green-200 text-green-800 rounded-lg px-4 py-3 text-sm">
          <%= notice %>
        </div>
      </div>
    <% end %>

    <main class="max-w-3xl mx-auto px-4 py-8">
      <%= yield %>
    </main>

  </body>
</html>
