#!/usr/bin/env bash
# Wrapper to use the npm @tailwindcss/cli instead of the gem's pre-compiled Bun binary,
# which doesn't run on NixOS due to the bunfs virtual filesystem requirement.
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
exec "$SCRIPT_DIR/../node_modules/.bin/tailwindcss" "$@"
